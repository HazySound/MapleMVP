{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:web": "vite --mode web",
    "build:web": "vite build --mode web --outDir dist-web",
    "deploy": "npm run build:web && wrangler pages deploy dist-web --project-name maplemvp"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/orbit": "^5.3.0",
    "gsap": "^3.15.0"
  }
}
